{
  "name": "mai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform AI image and video production studio",
  "homepage": "about:blank",
  "author": "MaiStudio",
  "license": "UNLICENSED",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.core.json",
    "build:ui": "vite build",
    "build": "npm run build:core && npm run build:ui",
    "test": "npm run build:core && node --test --test-concurrency=1 dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.ui.json --noEmit && git diff --check",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "check:docs": "node scripts/check-docs.js"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "ffmpeg-static": "5.3.0",
    "playwright-core": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "electron": "41.5.1",
    "electron-builder": "26.8.1",
    "typescript": "5.9.3",
    "vite": "6.4.2"
  },
  "build": {
    "appId": "com.maistudio.app",
    "productName": "MaiStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**",
      "dist/src/**",
      "dist/services/**",
      "dist-ui/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "MaiStudio"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
